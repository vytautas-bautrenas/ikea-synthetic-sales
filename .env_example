# User configuration, please update
# ----------------------------------------------------------------------
## Export: required so subprocesses see these vars after `source .env`
## (TerraForm, Python, dbt, AirFlow, web apps).

## GCP project ID & location.
export GCLOUD_PROJECT=your-gcp-project-id
export LOCATION=europe-west2

# End of user configuration



# Pre-set pointers, don't change.
# ----------------------------------------------------------------------
## Relative to Terraform / Python / dbt / Airflow / web app directories.
export GOOGLE_APPLICATION_CREDENTIALS=../secrets/gcp-sa-key.json
export TF_VAR_project_id=${GCLOUD_PROJECT}
export TF_VAR_location=${LOCATION}
export TF_VAR_credentials=../secrets/terraform-sa-key.json
